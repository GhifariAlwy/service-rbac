# service-rbac — SALIN ke .env lalu isi nilainya. JANGAN commit .env (CLAUDE.md §6 aturan #15)
NODE_ENV=development
SERVICE_NAME=service-rbac
PORT=3001
LOG_LEVEL=info

# MySQL db_rbac. Di dalam docker-compose host-nya adalah nama service, bukan localhost.
DATABASE_URL="mysql://beasiswa:CHANGE_ME@db-rbac:3306/db_rbac"

# JWT RS256 (ADR-005): private key HANYA ada di service ini.
JWT_PRIVATE_KEY_PATH=/run/secrets/private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/public.pem
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_TTL_REMEMBER_DAYS=30

# Email (MailHog saat pengembangan lokal)
SMTP_HOST=mailhog
SMTP_PORT=1025
MAIL_FROM=no-reply@beasiswa.local
APP_BASE_URL=http://localhost:5173
