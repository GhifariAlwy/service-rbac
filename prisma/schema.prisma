// db_rbac (MySQL) — lihat docs/ERD.md bagian 1
// Semua akses DB lewat Prisma (ADR-007): prepared statement otomatis, anti SQL injection.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  kode      String   @unique(map: "uq_roles_kode") @db.VarChar(30)
  nama      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users            User[]
  roleMenuAccesses RoleMenuAccess[]

  @@map("roles")
}

model User {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  // NIK diisi saat registrasi publik; NULL untuk user internal (docs/ASUMSI.md ASUMSI-02)
  nik             String?   @unique(map: "uq_users_nik") @db.VarChar(16)
  nama            String    @db.VarChar(150)
  username        String    @unique(map: "uq_users_username") @db.VarChar(50)
  email           String    @unique(map: "uq_users_email") @db.VarChar(150)
  // argon2id — tidak pernah plaintext, tidak pernah MD5/SHA1 (CLAUDE.md §6 aturan #2)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  roleId          BigInt    @map("role_id") @db.UnsignedBigInt
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  role               Role                @relation(fields: [roleId], references: [id])
  refreshTokens      RefreshToken[]
  emailVerifications EmailVerification[]

  @@index([roleId], map: "idx_users_role_id")
  @@map("users")
}

model Menu {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  parentId  BigInt?  @map("parent_id") @db.UnsignedBigInt
  nama      String   @db.VarChar(100)
  path      String   @db.VarChar(150)
  icon      String?  @db.VarChar(50)
  urutan    Int      @default(0) @db.UnsignedInt
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Menu?            @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children Menu[]           @relation("MenuHierarchy")
  accesses RoleMenuAccess[]

  @@index([parentId], map: "idx_menus_parent_id")
  @@index([urutan], map: "idx_menus_urutan")
  @@map("menus")
}

model RoleMenuAccess {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  roleId    BigInt   @map("role_id") @db.UnsignedBigInt
  menuId    BigInt   @map("menu_id") @db.UnsignedBigInt
  canView   Boolean  @default(false) @map("can_view")
  canCreate Boolean  @default(false) @map("can_create")
  canUpdate Boolean  @default(false) @map("can_update")
  canDelete Boolean  @default(false) @map("can_delete")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([roleId, menuId], map: "uq_role_menu")
  @@map("role_menu_access")
}

model RefreshToken {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt    @map("user_id") @db.UnsignedBigInt
  // Disimpan sebagai hash, bukan token mentah (CLAUDE.md §6 aturan #1)
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@index([expiresAt], map: "idx_refresh_tokens_expires_at")
  @@map("refresh_tokens")
}

model EmailVerification {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt    @map("user_id") @db.UnsignedBigInt
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_email_verifications_user_id")
  @@map("email_verifications")
}
